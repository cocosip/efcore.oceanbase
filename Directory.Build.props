<Project>
  <PropertyGroup>
    <OceanBasePackagePrefix Condition="'$(OceanBasePackagePrefix)' == ''">Sharp</OceanBasePackagePrefix>
    <OceanBaseProviderPackageId>$(OceanBasePackagePrefix).OceanBase.EntityFrameworkCore</OceanBaseProviderPackageId>
    <TargetFramework>net9.0</TargetFramework>
    <LangVersion>13.0</LangVersion>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <Deterministic>true</Deterministic>
    <Version>9.0.1</Version>
  </PropertyGroup>
</Project>

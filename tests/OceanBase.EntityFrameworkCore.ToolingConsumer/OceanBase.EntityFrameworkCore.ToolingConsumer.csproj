<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <IsPackable>false</IsPackable>
    <OceanBaseProviderVersion Condition="'$(OceanBaseProviderVersion)' == ''">9.0.1</OceanBaseProviderVersion>
    <OceanBaseConsumerEfCoreVersion Condition="'$(OceanBaseConsumerEfCoreVersion)' == ''">9.0.0</OceanBaseConsumerEfCoreVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="../OceanBase.EntityFrameworkCore.PackageConsumer/RecoverySmoke.cs" Link="RecoverySmoke.cs"
             Condition="Exists('../OceanBase.EntityFrameworkCore.PackageConsumer/RecoverySmoke.cs')" />
    <Compile Include="../TestUtilities/ScaffoldingCatalogConnection.cs" Link="ScaffoldingCatalogConnection.cs"
             Condition="Exists('../TestUtilities/ScaffoldingCatalogConnection.cs')" />
    <PackageReference Include="$(OceanBaseProviderPackageId)" Version="$(OceanBaseProviderVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="$(OceanBaseConsumerEfCoreVersion)"
                      PrivateAssets="all" IncludeAssets="all" />
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(OceanBaseConsumerEfCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(OceanBaseConsumerEfCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="$(OceanBaseConsumerEfCoreVersion)" />
  </ItemGroup>
</Project>

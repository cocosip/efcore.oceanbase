<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net9.0</TargetFramework>
    <ManagePackageVersionsCentrally>false</ManagePackageVersionsCentrally>
    <NuGetAudit>false</NuGetAudit>
    <IsPackable>false</IsPackable>
    <OceanBaseProviderVersion Condition="'$(OceanBaseProviderVersion)' == ''">9.0.1</OceanBaseProviderVersion>
    <OceanBaseConsumerProxiesVersion Condition="'$(OceanBaseConsumerEfCoreVersion)' != ''">$(OceanBaseConsumerEfCoreVersion)</OceanBaseConsumerProxiesVersion>
    <OceanBaseConsumerProxiesVersion Condition="'$(OceanBaseConsumerProxiesVersion)' == ''">9.0.0</OceanBaseConsumerProxiesVersion>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="$(OceanBaseProviderPackageId)" Version="$(OceanBaseProviderVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Proxies" Version="$(OceanBaseConsumerProxiesVersion)" />
  </ItemGroup>
  <ItemGroup Condition="'$(OceanBaseConsumerEfCoreVersion)' != ''">
    <PackageReference Include="Microsoft.EntityFrameworkCore" Version="$(OceanBaseConsumerEfCoreVersion)" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Relational" Version="$(OceanBaseConsumerEfCoreVersion)" />
  </ItemGroup>
</Project>
